# ARB 系统配置（protobuf text format，schema 见 proto/config/config.proto）
#
# ⚠️ 真实 broker 配置在 PG `broker_accounts` 表（docker arb-postgres，宿主 5433），不在本文件。
#    core 启动从 PG 加载 broker（见 cmd/core main.go §6b）。本文件 brokers 仅作 textproto 格式示例。

brokers: []  # 真实 broker 在 PG；此处留空

# ⚠️ strategies 的 schema 仍是旧 engine 设计（STRATEGY_TYPE_*）。
#    D-003 后策略改为 detector/evaluator，config.proto 待 Windsurf 按 docs/design 重定义。
#    下方保留旧结构仅作占位（enabled:false），不代表最终配置。
strategies: [
  {
    type: STRATEGY_TYPE_TRIANGULAR
    enabled: false
    subscribed_symbols: ["EURUSD", "GBPUSD", "EURGBP"]
  }
]

risk: {
  # P1 参数初值见 docs/design/discussion-log 讨论五；待 config.proto 按新架构重定义
  max_notional_per_trade: 10000
  max_consecutive_losses: 5
  daily_loss_limit: 5000
  max_concurrent_orders: 5
}

database: {
  # 宿主直连 docker PG 用 5433；core 容器内走 DB_DSN 环境变量（postgres:5432，见 docker-compose）。
  # 注意：宿主 5432 是另一个无 arb 库的系统 PG，勿用。
  dsn: "postgres://arb:arb@localhost:5433/arb?sslmode=disable"
}

dashboard: {
  listen_address: "0.0.0.0:50051"
  matrix_refresh_ms: 100
}
