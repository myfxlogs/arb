<Window x:Class="ArbDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ArbDesk.Views"
        Title="arb-cockpit" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="arb-cockpit" Foreground="White" FontWeight="Bold" Margin="0,0,16,0" />
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="#FFA500" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Padding="4">
            <TabItem Header="Opportunities">
                <views:OpportunityView />
            </TabItem>
            <TabItem Header="Matrix">
                <views:MatrixView />
            </TabItem>
            <TabItem Header="Positions">
                <views:PositionsView />
            </TabItem>
            <TabItem Header="Trading">
                <views:TradingView DataContext="{Binding TradingVM}" />
            </TabItem>
            <TabItem Header="History">
                <views:HistoryView DataContext="{Binding HistoryVM}" />
            </TabItem>
            <TabItem Header="Admin">
                <views:AdminView DataContext="{Binding AdminVM}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
